    "create-admin": "node scripts/create-admin.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.3.0",
    "next": "14.2.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "20.16.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  }
}
