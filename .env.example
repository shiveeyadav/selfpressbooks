# Copy to .env and fill in. Never commit .env.

# Public base URL (used for Stripe redirect URLs). No trailing slash.
SITE_URL=https://selfpressbooks.com

# Where the SQLite database and uploaded files live (a Docker volume in production).
DATA_DIR=./data

# Max upload size per file, in MB.
MAX_UPLOAD_MB=100

# Stripe. Leave empty and checkout will show "payments not configured".
# Use test keys (sk_test_...) until everything has been checked.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Host port for docker compose (bound to 127.0.0.1 only; nginx proxies to it).
HOST_PORT=3030
